const byte VOL_WIDTH = 19;
const byte VOL_HEIGHT = 13;

const byte PLAYSTOP_WIDTH = 7;
const byte PLAYSTOP_HEIGHT = 13;

const byte REPRODUCTOR_WIDTH = 17;
const byte REPRODUCTOR_HEIGHT = 13;

const byte SW_WIDTH = 46;
const byte SW_HEIGHT = 24;

unsigned long ultimoCheck = 0;
const long intervalo = 1500;
const long intervaloRnd = 2000; //tiempo para que se active o desactive el shuffle :)
const long intervaloRFID = 1000;
unsigned long inicioPresionRnd = 0; 
bool pasaIntervalo = false;
unsigned long ultimoCheckRFID = 0;
int numCanciones = 0;


void displayBitmaps(){
  display.drawBitmap( (display.width() - VOL_WIDTH - REPRODUCTOR_WIDTH - 2),(display.height() - VOL_HEIGHT),volumen_allArray[volIcon], VOL_WIDTH, VOL_HEIGHT, 1 );
  display.drawBitmap( (display.width() - PLAYSTOP_WIDTH)/2,(display.height() - PLAYSTOP_HEIGHT),playstop_allArray[int(isPlaying)], PLAYSTOP_WIDTH, PLAYSTOP_HEIGHT, 1 );
  display.drawBitmap( (display.width() - REPRODUCTOR_WIDTH),(display.height() - REPRODUCTOR_HEIGHT),reproductor_allArray[repMode], REPRODUCTOR_WIDTH, REPRODUCTOR_HEIGHT, 1 );
  //display.drawBitmap( (display.width() - SW_WIDTH)/2,8,soundwave_allArray[sw_frame], SW_WIDTH, SW_HEIGHT, 1 );

  display.drawLine(0, display.height()- PLAYSTOP_HEIGHT - 2, display.width(), display.height()- PLAYSTOP_HEIGHT - 2, SSD1306_WHITE);
}

//const byte SW_WIDTH = 46;
//const byte SW_HEIGHT = 24;

void setup(){
   Serial.begin(9600);
   mySoftwareSerial.begin(9600);
   SPI.begin();
   mfrc522.PCD_Init();
   display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
   
   display.clearDisplay();
   display.setTextSize(2);
   display.setTextColor(WHITE);
   display.setTextWrap(false);
   display.println("Cargando...");
   display.display();

   pinMode(playPauseBtn, INPUT_PULLUP);
   pinMode(randomBtn, INPUT_PULLUP);

   while (!myDFPlayer.begin(mySoftwareSerial)){
    delay(100);
    Serial.println(F("No se pudo iniciar DFPlayer..."));
   }
   Serial.println(F("DFPlayer activo"));

   //Volumen inicial
   volumen = map(constrain(analogRead(potenciometro),9,1013),9,1013,0,30);
   myDFPlayer.volume(volumen);
   lastVolumen = volumen;
   if (volumen = 0){
    volIcon = 0;
   }else{
    volIcon = map(volumen, 1,30,1,4);
   }
   
   myDFPlayer.enableLoopAll();
   numCanciones = myDFPlayer.readFileCounts();
}

void loop(){
  unsigned long inicioLoop = millis();
  display_freeram();
  if (inicioLoop - ultimoCheck >= intervalo){
    //cada cierto tiempo actualiza cual cancion esta sonando
    ultimoCheck = inicioLoop;

    currSong = myDFPlayer.readCurrentFileNumber();
    

    if (currSong != lastSong){
      //hubo un cambio
      if (currSong == -1 || currSong == 255){
        //errores de lectura por parte del DFPlayer. No cambiara el numero
        currSong = lastSong;
      }else
      {
        //el cambio es valido
        //strcpy(message, nombres[currSong-1]);
      }
      
    }
    if (numCanciones == -1 || numCanciones == 1){
      numCanciones = myDFPlayer.readFileCounts();
    }
  }

  //preparativos RFID
  MFRC522::MIFARE_Key key;
  for (byte i = 0; i<6; i++) key.keyByte[i] = 0xFF;

  byte block;
  byte len;
  MFRC522::StatusCode status;

  //leer los inputs
  int p = analogRead(potenciometro);
  byte ppbtn = digitalRead(playPauseBtn); //LOW=0, eso es cuando esta activado, HIGH=1 y eso es cuando esta desactivado
  byte rndbtn = digitalRead(randomBtn);

  //====== actualizar volumen =======
  volumen = map(constrain(p,9,1013), 9, 1013, 0, 30);
  if (volumen != lastVolumen){
    myDFPlayer.volume(volumen);
    if (volumen == 0){
      volIcon = 0;
    }else{
      volIcon = map(volumen, 1,25,1,4);
    }
  }
  lastVolumen = volumen;
  //=================================

  //===== boton de play =============
  if (ppbtn == 0 && btnPPPress == false){
    //el boton acaba de ser presionado y aun no se ejecuta esta instruccion
    btnPPPress = true;

    if(isPlaying){
      isPlaying = false;
      myDFPlayer.pause();
    }else{
      isPlaying = true;
      myDFPlayer.start(); //resume la cancion que ya sonaba (o inicia la primera)
    }
  }
  if (btnPPPress && ppbtn == 1){
    //el boton dejó de ser presionado
    btnPPPress = false;
  }
  //=================================
  
  // ===== boton de modo ============
  if (rndbtn == 0 && btnRndPress == false){
    btnRndPress = true;
    inicioPresionRnd = inicioLoop; //puede haber desfase
  }
  if (btnRndPress == true){
    pasaIntervalo = ((inicioLoop - inicioPresionRnd) >= intervaloRnd);
  }
  

  if (btnRndPress && rndbtn == 1){
    btnRndPress = false;
    //ahora que el boton fue soltado, haremos la accion solo si no excedio el intervalo
    if (pasaIntervalo == false){
      if (repMode == 0){
        //pasamos al modo loop
        myDFPlayer.enableLoop();
        repMode = 1;
      }else if (repMode == 1){
        //desactivamos el loop
        myDFPlayer.disableLoop();
        myDFPlayer.enableLoopAll();
        repMode = 0;
      }else{
        //estamos en el modo shuffle, y volveremos al 0
        repMode = 0;
        myDFPlayer.play(currSong);
        myDFPlayer.disableLoop();
        myDFPlayer.enableLoopAll();
      }
    }
    
  }

  if (pasaIntervalo){
    //activamos modo shuffle
    repMode = 2;
    myDFPlayer.disableLoop();
    myDFPlayer.randomAll(); //esto hara que se reproduzca una nueva cancion y se continua aleatoriamente
    isPlaying = true;
    pasaIntervalo = false;
    inicioPresionRnd = 0;
  }
  //==============================================================================

  display.clearDisplay();

  //bitmaps
  displayBitmaps();

  //
  display.setTextSize(1);
  display.setCursor(0,display.height() - 10);
  display.print(currSong);
  display.print("/");
  display.print(numCanciones);
  
  //muestra las cosas efectivamente en pantalla
  display.display();

  if (isPlaying) {
    sw_frame += 1;
  } else {
    sw_frame = 0;
  }

  if (sw_frame > 8){
    sw_frame = 1;
  }

  //====== RFID =======
  if (mfrc522.PICC_IsNewCardPresent() && inicioLoop - ultimoCheckRFID >= intervaloRFID){
    ultimoCheckRFID = inicioLoop;
    if (! mfrc522.PICC_ReadCardSerial()){ return; }
    
    //Se detecta una tarjeta
    mfrc522.PICC_DumpDetailsToSerial(&(mfrc522.uid));

    byte buffer2[18];
    block = 1;
    len = 18;

    status = mfrc522.PCD_Authenticate(MFRC522::PICC_CMD_MF_AUTH_KEY_A, 1, &key, &(mfrc522.uid));
    if (status != MFRC522::STATUS_OK) {
      Serial.print(F("Fallo la autenticacion de la tarjeta: "));
      Serial.println(mfrc522.GetStatusCodeName(status));
      return;
    }

    status = mfrc522.MIFARE_Read(block, buffer2, &len);
    if (status != MFRC522::STATUS_OK) {
      Serial.print(F("Lectura fallida de la tarjeta: "));
      Serial.println(mfrc522.GetStatusCodeName(status));
      return;
    }

    String num = "";

    for (uint8_t i = 0; i < 16; i++)
    {
      num += (char)buffer2[i];
      Serial.println(buffer2[i]);
    }
    Serial.println(num.toInt());
    num.trim();
    Serial.println(num.toInt());

    myDFPlayer.play(num.toInt());
    isPlaying = true;

    mfrc522.PICC_HaltA();
    mfrc522.PCD_StopCrypto1();

  }

}
void display_freeram() {
  Serial.print(F("- SRAM left: "));
  Serial.println(freeRam());
}

int freeRam() {
  extern int __heap_start,*__brkval;
  int v;
  return (int)&v - (__brkval == 0  
    ? (int)&__heap_start : (int) __brkval);  
}